{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "skill_instructions", "cases"],
  "properties": {
    "schema_version": {"const": 3},
    "suite": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude_code"],
      "properties": {
        "codex": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "pattern": "\\$design-dna"
        },
        "claude_code": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "pattern": "(^|\\s)/design-dna($|\\s)"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "review_requirements"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "task": {"type": "string", "minLength": 10, "maxLength": 20000},
          "invocation_mode": {
            "type": "string",
            "enum": ["explicit", "implicit"],
            "default": "explicit",
            "description": "Explicit prepends the selected host's skill_instructions value only to the staged-skill variant; implicit sends the natural task unchanged and relies on host-native discovery. The baseline always receives the natural task and has no staged skill."
          },
          "input_dir": {"$ref": "#/$defs/relative_path"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "tags": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "adversarial": {"type": "boolean"},
          "release_coverage": {"$ref": "#/$defs/release_coverage"},
          "review_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 5, "maxLength": 1000}
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exit_codes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer"}
              },
              "stdout_contains": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "stderr_contains": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "files_exist": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/relative_path"}
              },
              "files_absent": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/relative_path"}
              },
              "files_unchanged": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/relative_path"}
              },
              "changed_files_only": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/relative_path"}
              },
              "max_changed_input_files": {
                "type": "integer",
                "minimum": 0
              },
              "file_contains": {"$ref": "#/$defs/file_text_checks"},
              "file_not_contains": {"$ref": "#/$defs/file_text_checks"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^[/\\\\]|^[A-Za-z]:|\\\\|//|(?:^|/)\\.{1,2}(?:/|$)|[\\u0000-\\u001f\\u007f])"
          }
        },
        {"not": {"pattern": "/$"}},
        {"not": {"pattern": "^\\s|\\s$"}}
      ]
    },
    "release_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_value",
        "representative",
        "primary_mode",
        "scope",
        "project_stratum"
      ],
      "properties": {
        "high_value": {"const": true},
        "representative": {"const": true},
        "primary_mode": {
          "enum": ["persuade", "experience", "operate", "read"]
        },
        "scope": {
          "enum": ["new-build", "redesign", "component", "review"]
        },
        "project_stratum": {
          "enum": [
            "static-site",
            "established-interface",
            "framework-application-data"
          ]
        }
      }
    },
    "file_text_checks": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/relative_path"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}

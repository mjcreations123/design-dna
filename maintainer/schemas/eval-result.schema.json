{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 12,
      "maxLength": 320,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:(?:codex|claude_code):[a-z0-9]+(?:-[a-z0-9]+)*:(?:skill|baseline):[1-9][0-9]*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^[/\\\\]|^[A-Za-z]:|\\\\|//|(?:^|/)\\.{1,2}(?:/|$)|[\\u0000-\\u001f\\u007f])"
          }
        },
        {"not": {"pattern": "/$"}},
        {"not": {"pattern": "^\\s|\\s$"}}
      ]
    },
    "count_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "release_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_value",
        "representative",
        "primary_mode",
        "scope",
        "project_stratum"
      ],
      "properties": {
        "high_value": {"const": true},
        "representative": {"const": true},
        "primary_mode": {
          "enum": ["persuade", "experience", "operate", "read"]
        },
        "scope": {
          "enum": ["new-build", "redesign", "component", "review"]
        },
        "project_stratum": {
          "enum": [
            "static-site",
            "established-interface",
            "framework-application-data"
          ]
        },
        "expressive_perception_gate": {"const": true},
        "quiet_perception_gate": {"const": true},
        "generated_media_capability_gate": {"const": true}
      },
      "not": {
        "required": [
          "expressive_perception_gate",
          "quiet_perception_gate"
        ]
      }
    },
    "review_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^requirement-[0-9]{2}-[0-9a-f]{16}$"
        },
        "text": {"type": "string", "minLength": 5, "maxLength": 1000},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "adversarial_required",
        "requirements",
        "release_coverage",
        "sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "adversarial_required": {"type": "boolean"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/review_requirement"}
        },
        "release_coverage": {
          "oneOf": [
            {"$ref": "#/$defs/release_coverage"},
            {"type": "null"}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "type": {"enum": ["file", "directory"]},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "file"}}
          },
          "then": {
            "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "directory"}}
          },
          "then": {
            "properties": {
              "size": {"const": 0},
              "sha256": {"type": "null"}
            }
          }
        }
      ]
    },
    "model_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_status",
        "provider",
        "model",
        "model_version",
        "reasoning_effort",
        "generation_config",
        "declaration_source",
        "sha256"
      ],
      "properties": {
        "declaration_status": {"enum": ["declared", "unreported"]},
        "provider": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
        },
        "model_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$",
          "not": {
            "enum": ["latest", "current", "default", "unknown", "unreported"]
          }
        },
        "reasoning_effort": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "generation_config": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "enum": [
              "temperature",
              "top_p",
              "top_k",
              "seed",
              "max_output_tokens",
              "max_tokens",
              "reasoning_budget",
              "thinking_budget",
              "response_format",
              "tool_choice",
              "parallel_tool_calls"
            ]
          },
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"],
            "maxLength": 64
          }
        },
        "declaration_source": {
          "enum": ["maintainer-cli", "inherited-from-skill", "not-provided"]
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "required": ["declaration_status"],
            "properties": {"declaration_status": {"const": "declared"}}
          },
          "then": {
            "properties": {
              "provider": {"type": "string"},
              "model": {"type": "string"},
              "model_version": {"type": "string"},
              "reasoning_effort": {"type": "string"},
              "declaration_source": {
                "enum": ["maintainer-cli", "inherited-from-skill"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["declaration_status"],
            "properties": {"declaration_status": {"const": "unreported"}}
          },
          "then": {
            "properties": {
              "provider": {"type": "null"},
              "model": {"type": "null"},
              "model_version": {"type": "null"},
              "reasoning_effort": {"type": "null"},
              "generation_config": {"maxProperties": 0},
              "declaration_source": {"const": "not-provided"}
            }
          }
        }
      ]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "resolved",
        "sha256",
        "argument_template_sha256",
        "argument_count",
        "model_context"
      ],
      "properties": {
        "requested": {"type": "string", "minLength": 1, "maxLength": 4096},
        "resolved": {"type": "string", "minLength": 1, "maxLength": 32768},
        "sha256": {"$ref": "#/$defs/sha256"},
        "argument_template_sha256": {"$ref": "#/$defs/sha256"},
        "argument_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "model_context": {"$ref": "#/$defs/model_context"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "entry_count", "file_count", "bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "entry_count": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "before_sha256",
        "after_sha256",
        "changed",
        "changed_entries",
        "changed_entries_truncated"
      ],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 32768},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "changed": {"type": "boolean"},
        "changed_entries": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "changed_entries_truncated": {"type": "boolean"},
        "error": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    },
    "driver_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "host",
        "case",
        "variant",
        "run",
        "skill_loaded",
        "skill_content_sha256",
        "driver_name",
        "driver_version"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "host": {"enum": ["codex", "claude_code"]},
        "case": {"$ref": "#/$defs/slug"},
        "variant": {"enum": ["skill", "baseline"]},
        "run": {"type": "integer", "minimum": 1, "maximum": 20},
        "skill_loaded": {"type": "boolean"},
        "skill_content_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "driver_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "driver_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "artifact_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "entry_count", "file_count", "bytes", "source"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "entry_count": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "source": {"const": "promoted-workspace"}
      }
    },
    "sensitive_artifact_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "complete",
        "detected",
        "finding_count",
        "path_sha256",
        "findings_truncated"
      ],
      "properties": {
        "performed": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "detected": {"type": "boolean"},
        "finding_count": {"type": "integer", "minimum": 0},
        "path_sha256": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "findings_truncated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "required": ["detected"],
            "properties": {"detected": {"const": false}}
          },
          "then": {
            "properties": {
              "finding_count": {"const": 0},
              "path_sha256": {"maxItems": 0},
              "findings_truncated": {"const": false}
            }
          }
        },
        {
          "if": {
            "required": ["performed"],
            "properties": {"performed": {"const": false}}
          },
          "then": {
            "properties": {
              "complete": {"const": true},
              "detected": {"const": false}
            }
          }
        }
      ]
    },
    "host_native_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "challenge_id",
        "session_nonce",
        "run_nonce",
        "issued_at"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "challenge_id": {"$ref": "#/$defs/sha256"},
        "session_nonce": {"$ref": "#/$defs/nonce"},
        "run_nonce": {"$ref": "#/$defs/nonce"},
        "issued_at": {"type": "string", "format": "date-time"}
      }
    },
    "host_native_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "challenge_id",
        "challenge_sha256",
        "session_nonce",
        "run_nonce",
        "method",
        "source_id",
        "source_version",
        "observed_at",
        "captured_at"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "challenge_id": {"$ref": "#/$defs/sha256"},
        "challenge_sha256": {"$ref": "#/$defs/sha256"},
        "session_nonce": {"$ref": "#/$defs/nonce"},
        "run_nonce": {"$ref": "#/$defs/nonce"},
        "method": {
          "enum": [
            "host-adapter-event",
            "host-api-telemetry",
            "host-runtime-log"
          ]
        },
        "source_id": {"type": "string", "minLength": 3, "maxLength": 256},
        "source_version": {"type": "string", "minLength": 3, "maxLength": 256},
        "observed_at": {"type": "string", "format": "date-time"},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "session_nonce",
    "started_at",
    "finished_at",
    "host",
    "package",
    "drivers",
    "provenance",
    "prompt_contract",
    "runs",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "suite": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "session_nonce": {"$ref": "#/$defs/nonce"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "host": {"enum": ["codex", "claude_code"]},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_sha256", "skill_root"],
      "properties": {
        "name": {"const": "design-dna"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "skill_root": {"type": "string", "minLength": 1, "maxLength": 32768}
      }
    },
    "drivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "baseline"],
      "properties": {
        "skill": {"$ref": "#/$defs/driver"},
        "baseline": {
          "oneOf": [
            {"$ref": "#/$defs/driver"},
            {"type": "null"}
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "harness_sha256",
        "suite_schema_sha256",
        "result_schema_sha256",
        "selected_cases",
        "runs_per_case",
        "input_snapshots",
        "monitor_roots",
        "passed_environment_names",
        "driver_report_required",
        "host_native_evidence_required",
        "host_native_evidence_source_configured",
        "host_native_evidence_timeout_seconds",
        "execution_order",
        "workspace_limits",
        "cleanup_problem",
        "retained_session"
      ],
      "properties": {
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "harness_sha256": {"$ref": "#/$defs/sha256"},
        "suite_schema_sha256": {"$ref": "#/$defs/sha256"},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "selected_cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        },
        "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 20},
        "input_snapshots": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {"$ref": "#/$defs/snapshot"}
        },
        "monitor_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 32768}
        },
        "passed_environment_names": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "driver_report_required": {"type": "boolean"},
        "host_native_evidence_required": {"type": "boolean"},
        "host_native_evidence_source_configured": {"type": "boolean"},
        "host_native_evidence_timeout_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "execution_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/run_id"}
        },
        "workspace_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_entries",
            "max_files",
            "max_bytes",
            "max_output_bytes",
            "max_inspect_text_bytes"
          ],
          "properties": {
            "max_entries": {"type": "integer", "minimum": 1},
            "max_files": {"type": "integer", "minimum": 1},
            "max_bytes": {"type": "integer", "minimum": 1},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "max_inspect_text_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "cleanup_problem": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 10000
        },
        "retained_session": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32768
        }
      }
    },
    "prompt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_instruction",
        "baseline_instruction",
        "task_text_identical",
        "implicit_uses_natural_task_only",
        "invocation_modes",
        "installation_modes"
      ],
      "properties": {
        "skill_instruction": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "pattern": "(\\$design-dna|(^|\\s)/design-dna($|\\s))"
        },
        "baseline_instruction": {"type": "null"},
        "task_text_identical": {"const": true},
        "implicit_uses_natural_task_only": {"const": true},
        "invocation_modes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"enum": ["explicit", "implicit"]}
        },
        "installation_modes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"const": "direct-skill"}
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "case",
          "variant",
          "host",
          "run",
          "started_at",
          "finished_at",
          "invocation_mode",
          "installation_mode",
          "passed",
          "problems",
          "returncode",
          "timed_out",
          "output_limit_exceeded",
          "duration_seconds",
          "stdout",
          "stderr",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_bytes",
          "stderr_bytes",
          "stdout_truncated",
          "stderr_truncated",
          "task_sha256",
          "prompt_sha256",
          "input_snapshot_sha256",
          "review_requirements",
          "review_contract",
          "tags",
          "adversarial",
          "skill_staged",
          "skill_content_sha256",
          "skill_route_verified_before",
          "skill_route_verified_after",
          "driver_report_status",
          "driver_report",
          "host_native_challenge",
          "host_native_evidence_status",
          "host_native_evidence",
          "monitors",
          "workspace_sha256",
          "workspace_entry_count",
          "workspace_file_count",
          "workspace_bytes",
          "files",
          "changed_paths",
          "sensitive_artifact_scan",
          "artifact_bundle",
          "workspace"
        ],
        "properties": {
          "run_id": {"$ref": "#/$defs/run_id"},
          "case": {"$ref": "#/$defs/slug"},
          "variant": {"enum": ["skill", "baseline"]},
          "host": {"enum": ["codex", "claude_code"]},
          "run": {"type": "integer", "minimum": 1, "maximum": 20},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "invocation_mode": {"enum": ["explicit", "implicit"]},
          "installation_mode": {"const": "direct-skill"},
          "passed": {"type": "boolean"},
          "problems": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 10000}
          },
          "returncode": {"type": "integer"},
          "timed_out": {"type": "boolean"},
          "output_limit_exceeded": {"type": "boolean"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "stdout": {"type": "string", "maxLength": 250000},
          "stderr": {"type": "string", "maxLength": 250000},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"},
          "stdout_bytes": {"type": "integer", "minimum": 0},
          "stderr_bytes": {"type": "integer", "minimum": 0},
          "stdout_truncated": {"type": "boolean"},
          "stderr_truncated": {"type": "boolean"},
          "task_sha256": {"$ref": "#/$defs/sha256"},
          "prompt_sha256": {"$ref": "#/$defs/sha256"},
          "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
          "review_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 5, "maxLength": 1000}
          },
          "review_contract": {"$ref": "#/$defs/review_contract"},
          "tags": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "adversarial": {"type": "boolean"},
          "skill_staged": {"type": "boolean"},
          "skill_content_sha256": {
            "oneOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          },
          "skill_route_verified_before": {"type": "boolean"},
          "skill_route_verified_after": {"type": "boolean"},
          "driver_report_status": {
            "enum": ["not_requested", "missing", "invalid", "driver_reported"]
          },
          "driver_report": {
            "oneOf": [
              {"$ref": "#/$defs/driver_report"},
              {"type": "null"}
            ]
          },
          "host_native_challenge": {
            "oneOf": [
              {"$ref": "#/$defs/host_native_challenge"},
              {"type": "null"}
            ]
          },
          "host_native_evidence_status": {
            "enum": ["not_requested", "missing", "invalid", "bound"]
          },
          "host_native_evidence": {
            "oneOf": [
              {"$ref": "#/$defs/host_native_evidence"},
              {"type": "null"}
            ]
          },
          "monitors": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/monitor"}
          },
          "workspace_sha256": {
            "oneOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          },
          "workspace_entry_count": {"type": "integer", "minimum": 0},
          "workspace_file_count": {"type": "integer", "minimum": 0},
          "workspace_bytes": {"type": "integer", "minimum": 0},
          "files": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/file"}
          },
          "changed_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relative_path"}
          },
          "sensitive_artifact_scan": {
            "$ref": "#/$defs/sensitive_artifact_scan"
          },
          "artifact_bundle": {
            "oneOf": [
              {"$ref": "#/$defs/artifact_bundle"},
              {"type": "null"}
            ]
          },
          "workspace": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["variant"],
              "properties": {"variant": {"const": "skill"}}
            },
            "then": {
              "properties": {
                "skill_staged": {"const": true},
                "skill_content_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          },
          {
            "if": {
              "required": ["variant"],
              "properties": {"variant": {"const": "baseline"}}
            },
            "then": {
              "properties": {
                "skill_staged": {"const": false},
                "skill_content_sha256": {"type": "null"}
              }
            }
          },
          {
            "if": {
              "required": ["driver_report_status"],
              "properties": {"driver_report_status": {"const": "driver_reported"}}
            },
            "then": {
              "properties": {
                "driver_report": {"$ref": "#/$defs/driver_report"}
              }
            }
          },
          {
            "if": {
              "required": ["driver_report_status"],
              "properties": {
                "driver_report_status": {
                  "enum": ["not_requested", "missing"]
                }
              }
            },
            "then": {
              "properties": {"driver_report": {"type": "null"}}
            }
          },
          {
            "if": {
              "required": ["host_native_evidence_status"],
              "properties": {"host_native_evidence_status": {"const": "bound"}}
            },
            "then": {
              "properties": {
                "host_native_challenge": {
                  "$ref": "#/$defs/host_native_challenge"
                },
                "host_native_evidence": {
                  "$ref": "#/$defs/host_native_evidence"
                }
              }
            }
          },
          {
            "if": {
              "required": ["host_native_evidence_status"],
              "properties": {
                "host_native_evidence_status": {"const": "not_requested"}
              }
            },
            "then": {
              "properties": {
                "host_native_challenge": {"type": "null"},
                "host_native_evidence": {"type": "null"}
              }
            }
          },
          {
            "if": {
              "required": ["host_native_evidence_status"],
              "properties": {
                "host_native_evidence_status": {
                  "enum": ["missing", "invalid"]
                }
              }
            },
            "then": {
              "properties": {"host_native_evidence": {"type": "null"}}
            }
          },
          {
            "if": {
              "required": ["passed"],
              "properties": {"passed": {"const": true}}
            },
            "then": {
              "properties": {
                "problems": {"maxItems": 0},
                "timed_out": {"const": false},
                "output_limit_exceeded": {"const": false},
                "skill_route_verified_before": {"const": true},
                "skill_route_verified_after": {"const": true},
                "workspace_sha256": {"$ref": "#/$defs/sha256"},
                "artifact_bundle": {"$ref": "#/$defs/artifact_bundle"}
              }
            },
            "else": {
              "properties": {"problems": {"minItems": 1}}
            }
          },
          {
            "if": {
              "required": ["passed", "variant", "invocation_mode"],
              "properties": {
                "passed": {"const": true},
                "variant": {"const": "skill"},
                "invocation_mode": {"const": "implicit"}
              }
            },
            "then": {
              "properties": {
                "host_native_evidence_status": {"const": "bound"},
                "host_native_challenge": {
                  "$ref": "#/$defs/host_native_challenge"
                },
                "host_native_evidence": {
                  "$ref": "#/$defs/host_native_evidence"
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "by_variant"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "by_variant": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "skill": {"$ref": "#/$defs/count_summary"},
            "baseline": {"$ref": "#/$defs/count_summary"}
          }
        }
      }
    }
  }
}

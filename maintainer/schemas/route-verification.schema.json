{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "verified_at",
    "canonical",
    "scan_scope",
    "roots",
    "expected",
    "canonical_sha256",
    "routes"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "record_type": {"const": "design-dna-route-verification"},
    "status": {"const": "passed"},
    "verified_at": {"type": "string", "format": "date-time"},
    "canonical": {"const": "skills/design-dna"},
    "scan_scope": {"$ref": "#/$defs/scan_scope"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/home_path"}
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/home_path"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_sha256", "matches_canonical"],
        "properties": {
          "path": {"$ref": "#/$defs/home_path"},
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "matches_canonical": {"const": true}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "home_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^~/[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$",
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      }
    },
    "scan_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "root_scope",
        "activation_state",
        "project_admin_session_routes",
        "limitations"
      ],
      "properties": {
        "basis": {"const": "explicit-filesystem-root-scan"},
        "root_scope": {"const": "explicit-roots-only"},
        "activation_state": {"const": "not-verified"},
        "project_admin_session_routes": {"const": "not-inspected"},
        "limitations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "verified_at",
    "canonical",
    "roots",
    "expected",
    "canonical_sha256",
    "routes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "design-dna-route-verification"},
    "status": {"const": "passed"},
    "verified_at": {"type": "string", "format": "date-time"},
    "canonical": {"type": "string", "minLength": 1},
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_sha256", "matches_canonical"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "matches_canonical": {"const": true}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

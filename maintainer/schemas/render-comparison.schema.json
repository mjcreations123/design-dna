{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-dna.local/schemas/render-comparison.schema.json",
  "title": "Design DNA cross-build rendered comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "comparison_id",
    "created_at",
    "output_identity",
    "execution_ok",
    "review_required",
    "automatic_visual_approval",
    "decision_status",
    "execution",
    "privacy",
    "mask_policy",
    "inputs",
    "compatibility",
    "baseline_freshness",
    "comparisons",
    "summary",
    "artifacts",
    "manual_review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "report_schema"],
      "properties": {
        "name": {"const": "design-dna-render-comparison"},
        "version": {"const": "1.0.0"},
        "report_schema": {"const": "render-comparison.schema.json"}
      }
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "output_identity": {"$ref": "#/$defs/output_identity"},
    "execution_ok": {"const": true},
    "review_required": {"const": true},
    "automatic_visual_approval": {"const": false},
    "decision_status": {"const": "human-accept-reject-required"},
    "execution": {"$ref": "#/$defs/execution"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "mask_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "mode", "declaration", "regions_applied"],
      "properties": {
        "supported": {"const": false},
        "mode": {"const": "none"},
        "declaration": {"const": "operator-explicit"},
        "regions_applied": {"const": 0}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {
          "allOf": [
            {"$ref": "#/$defs/input_identity"},
            {"properties": {"role": {"const": "baseline"}}}
          ]
        },
        "candidate": {
          "allOf": [
            {"$ref": "#/$defs/input_identity"},
            {"properties": {"role": {"const": "candidate"}}}
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "capture_count",
        "capture_contract_sha256",
        "route_contract_sha256",
        "capture_identity_sha256",
        "environment_differences",
        "warnings"
      ],
      "properties": {
        "status": {"const": "compatible"},
        "capture_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        },
        "capture_contract_sha256": {"$ref": "#/$defs/sha256"},
        "route_contract_sha256": {"$ref": "#/$defs/sha256"},
        "capture_identity_sha256": {"$ref": "#/$defs/sha256"},
        "environment_differences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/environment_difference"}
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 100}
        }
      }
    },
    "baseline_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "threshold_days", "age_days", "warnings"],
      "properties": {
        "status": {"enum": ["current", "stale", "indeterminate"]},
        "threshold_days": {"const": 30},
        "age_days": {"type": "number"},
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 100}
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 72,
      "items": {"$ref": "#/$defs/comparison"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_count",
        "changed_capture_count",
        "total_pixels",
        "mismatch_pixels",
        "mismatch_pixel_ratio"
      ],
      "properties": {
        "capture_count": {"type": "integer", "minimum": 1, "maximum": 72},
        "changed_capture_count": {"type": "integer", "minimum": 0, "maximum": 72},
        "total_pixels": {"type": "integer", "minimum": 1},
        "mismatch_pixels": {"type": "integer", "minimum": 0},
        "mismatch_pixel_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_sheet", "comparison_bytes"],
      "properties": {
        "contact_sheet": {"$ref": "#/$defs/html_artifact"},
        "comparison_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        }
      }
    },
    "manual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_actions", "limitations"],
      "properties": {
        "status": {"const": "required"},
        "required_actions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 30}
        },
        "limitations": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 40}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^[/\\\\]|^[A-Za-z]:|:|\\\\|//|(?:^|/)\\.{1,2}(?:/|$)|[\\u0000-\\u001f\\u007f])"
          }
        },
        {"not": {"pattern": "(?:[. ]|/)$"}}
      ]
    },
    "output_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/sha256"},
        "path_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "product_hint",
        "version",
        "executable_source",
        "executable_name"
      ],
      "properties": {
        "engine": {"const": "chromium"},
        "product_hint": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable_source": {
          "enum": ["explicit", "playwright", "system-discovery"]
        },
        "executable_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {"pattern": "[/\\\\]"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_version",
        "platform",
        "architecture",
        "playwright_version",
        "playwright_source",
        "browser",
        "network_policy"
      ],
      "properties": {
        "node_version": {"type": "string", "minLength": 2},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "playwright_version": {"type": "string", "minLength": 1},
        "playwright_source": {
          "enum": [
            "normal-node-resolution",
            "environment-module-directory"
          ]
        },
        "browser": {"$ref": "#/$defs/browser"},
        "network_policy": {
          "const": "offline-about-blank-data-png-decode-all-routed-requests-blocked"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "visual_content_not_redacted",
        "absolute_paths_persisted",
        "retention_notice",
        "limitations"
      ],
      "properties": {
        "classification": {
          "const": "potentially-sensitive-rendered-comparison-evidence"
        },
        "visual_content_not_redacted": {"const": true},
        "absolute_paths_persisted": {"const": false},
        "retention_notice": {"type": "string", "minLength": 60},
        "limitations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 50}
        }
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report.tool.version",
        "execution.node_version",
        "execution.platform",
        "execution.architecture",
        "execution.playwright_version",
        "execution.browser.engine",
        "execution.browser.product_hint",
        "execution.browser.version",
        "execution.browser.executable_source",
        "execution.browser.executable_name"
      ],
      "properties": {
        "report.tool.version": {"type": "string", "minLength": 1},
        "execution.node_version": {"type": "string", "minLength": 1},
        "execution.platform": {"type": "string", "minLength": 1},
        "execution.architecture": {"type": "string", "minLength": 1},
        "execution.playwright_version": {"type": "string", "minLength": 1},
        "execution.browser.engine": {"type": "string", "minLength": 1},
        "execution.browser.product_hint": {"type": "string", "minLength": 1},
        "execution.browser.version": {"type": "string", "minLength": 1},
        "execution.browser.executable_source": {
          "type": "string",
          "minLength": 1
        },
        "execution.browser.executable_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "report_sha256",
        "report_bytes",
        "render_report_schema_sha256",
        "output_identity",
        "build",
        "captured_at",
        "marker_created_at",
        "execution_environment"
      ],
      "properties": {
        "role": {"enum": ["baseline", "candidate"]},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "report_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "render_report_schema_sha256": {"$ref": "#/$defs/sha256"},
        "output_identity": {"$ref": "#/$defs/output_identity"},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "id_sha256",
            "target_kind",
            "source_manifest_sha256"
          ],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 256},
            "id_sha256": {"$ref": "#/$defs/sha256"},
            "target_kind": {"enum": ["local-file", "local-directory"]},
            "source_manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "captured_at": {"type": "string", "format": "date-time"},
        "marker_created_at": {"type": "string", "format": "date-time"},
        "execution_environment": {"$ref": "#/$defs/execution_environment"}
      }
    },
    "environment_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "baseline", "candidate"],
      "properties": {
        "field": {"type": "string", "minLength": 3, "maxLength": 100},
        "baseline": {"type": "string", "maxLength": 256},
        "candidate": {"type": "string", "maxLength": 256}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "device_scale_factor"],
      "properties": {
        "width": {"type": "integer", "minimum": 240, "maximum": 3840},
        "height": {"type": "integer", "minimum": 240, "maximum": 2160},
        "device_scale_factor": {"type": "number", "minimum": 1, "maximum": 3}
      }
    },
    "capture_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_id",
        "scenario_id",
        "profile_id",
        "route_label",
        "state_label",
        "viewport",
        "preferences",
        "review_mode",
        "interaction"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 97},
        "route_id": {"type": "string", "pattern": "^route-[0-9]{2}$"},
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "route_label": {"type": "string", "minLength": 1, "maxLength": 80},
        "state_label": {"type": "string", "minLength": 1, "maxLength": 80},
        "viewport": {"$ref": "#/$defs/viewport"},
        "preferences": {"type": "object", "minProperties": 1},
        "review_mode": {"type": "object", "minProperties": 1},
        "interaction": {"type": "object", "minProperties": 1}
      }
    },
    "png_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "bytes",
        "pixel_width",
        "pixel_height"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/portable_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"const": "image/png"},
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "pixel_width": {"type": "integer", "minimum": 1, "maximum": 32768},
        "pixel_height": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "html_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type", "bytes"],
      "properties": {
        "path": {"const": "comparison.html"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"const": "text/html"},
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "identity",
        "artifacts",
        "metrics",
        "review_status"
      ],
      "properties": {
        "capture_id": {"type": "string", "minLength": 3, "maxLength": 97},
        "identity": {"$ref": "#/$defs/capture_identity"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "actual", "diff"],
          "properties": {
            "baseline": {"$ref": "#/$defs/png_artifact"},
            "actual": {"$ref": "#/$defs/png_artifact"},
            "diff": {"$ref": "#/$defs/png_artifact"}
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "total_pixels",
            "mismatch_pixels",
            "mismatch_pixel_ratio"
          ],
          "properties": {
            "algorithm": {"const": "exact-decoded-rgba-v1"},
            "total_pixels": {"type": "integer", "minimum": 1},
            "mismatch_pixels": {"type": "integer", "minimum": 0},
            "mismatch_pixel_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "review_status": {"const": "human-accept-reject-required"}
      }
    }
  }
}

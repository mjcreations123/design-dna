{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-dna.local/schemas/route-family.schema.json",
  "title": "Design DNA route-family range-study contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_with",
    "classification",
    "study",
    "shared_contract",
    "routes",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "created_with": {"$ref": "#/$defs/created_with"},
    "classification": {"const": "internal"},
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "requested_route_count"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/short_text"},
        "requested_route_count": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "shared_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "navigation",
        "truth",
        "accessibility",
        "voice",
        "performance"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/long_text"},
        "navigation": {"$ref": "#/$defs/long_text"},
        "truth": {"$ref": "#/$defs/long_text"},
        "accessibility": {"$ref": "#/$defs/long_text"},
        "voice": {"$ref": "#/$defs/long_text"},
        "performance": {"$ref": "#/$defs/long_text"}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/route"}
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "created_with": {
      "type": "string",
      "pattern": "^design-dna (0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "route_path": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[^?#\\\\\\u0000-\\u0020\\u007f]*$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "long_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "creative_logic": {
      "oneOf": [
        {"$ref": "#/$defs/long_text"},
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "additionalProperties": true
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "width": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 240,
              "maximum": 3840
            },
            {"type": "null"}
          ]
        }
      }
    },
    "capture_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/viewport"}
        }
      }
    },
    "observable_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "evidence", "status"],
      "properties": {
        "decision": {"$ref": "#/$defs/long_text"},
        "reason": {"$ref": "#/$defs/long_text"},
        "evidence": {"$ref": "#/$defs/long_text"},
        "status": {"enum": ["provisional", "accepted", "revised", "rejected"]}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "user_job",
        "creative_logic",
        "observable_decisions",
        "responsive_result",
        "reduced_motion_result",
        "no_javascript_result",
        "closest_sibling",
        "deliberate_differences",
        "capture_requirements",
        "review_status"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/route_path"},
        "title": {"$ref": "#/$defs/short_text"},
        "user_job": {"$ref": "#/$defs/long_text"},
        "creative_logic": {"$ref": "#/$defs/creative_logic"},
        "observable_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {"$ref": "#/$defs/observable_decision"}
        },
        "responsive_result": {"$ref": "#/$defs/long_text"},
        "reduced_motion_result": {"$ref": "#/$defs/long_text"},
        "no_javascript_result": {"$ref": "#/$defs/long_text"},
        "closest_sibling": {
          "oneOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        },
        "deliberate_differences": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/long_text"}
        },
        "capture_requirements": {
          "$ref": "#/$defs/capture_requirements"
        },
        "review_status": {
          "enum": ["planned", "implemented", "audited", "accepted"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "enum": ["implemented", "audited", "accepted"]
              }
            },
            "required": ["review_status"]
          },
          "then": {
            "properties": {
              "capture_requirements": {
                "properties": {
                  "viewports": {
                    "items": {
                      "properties": {
                        "width": {
                          "type": "integer",
                          "minimum": 240,
                          "maximum": 3840
                        }
                      },
                      "required": ["width"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cultural_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer_id",
        "relationship",
        "independent_of_producer",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "status": {
          "enum": ["not-required", "pending", "accepted", "rejected"]
        },
        "reviewer_id": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 160},
            {"type": "null"}
          ]
        },
        "relationship": {
          "enum": [
            "accountable-community-authority",
            "owner-authorized-cultural-reviewer",
            "not-reviewed"
          ]
        },
        "independent_of_producer": {"type": "boolean"},
        "reviewed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "notes": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 2000},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"required": {"const": false}},
            "required": ["required"]
          },
          "then": {
            "properties": {
              "status": {"const": "not-required"},
              "reviewer_id": {"type": "null"},
              "relationship": {"const": "not-reviewed"},
              "independent_of_producer": {"const": false},
              "reviewed_at": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "status": {"enum": ["pending", "accepted", "rejected"]}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "required": {"const": true},
              "reviewer_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "relationship": {
                "enum": [
                  "accountable-community-authority",
                  "owner-authorized-cultural-reviewer"
                ]
              },
              "independent_of_producer": {"const": true},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "pending"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reviewer_id": {"type": "null"},
              "relationship": {"const": "not-reviewed"},
              "reviewed_at": {"type": "null"}
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_entry",
        "link_integrity",
        "route_count",
        "body_comparison",
        "atlas_artifact",
        "cultural_acceptance"
      ],
      "properties": {
        "direct_entry": {"enum": ["pending", "passed", "failed"]},
        "link_integrity": {"enum": ["pending", "passed", "failed"]},
        "route_count": {"enum": ["pending", "passed", "failed"]},
        "body_comparison": {
          "enum": ["pending", "manual-review-required", "reviewed"]
        },
        "atlas_artifact": {
          "enum": ["pending", "not-available", "produced", "reviewed"]
        },
        "cultural_acceptance": {
          "$ref": "#/$defs/cultural_acceptance"
        }
      }
    }
  }
}

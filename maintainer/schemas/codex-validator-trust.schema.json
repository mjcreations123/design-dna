{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-dna.local/schemas/codex-validator-trust.schema.json",
  "title": "Design DNA Codex validator trust pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "logical_id",
    "path_suffix",
    "sha256",
    "bytes",
    "support_files",
    "reviewed_at",
    "review_due",
    "review_basis",
    "trust_boundary"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "design-dna-codex-validator-trust-pin"},
    "logical_id": {"const": "plugin-creator/validate_plugin.py"},
    "path_suffix": {
      "const": "/skills/.system/plugin-creator/scripts/validate_plugin.py"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "support_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "path_suffix", "sha256", "bytes"],
        "properties": {
          "logical_id": {
            "const": "plugin-creator/identifier_validation.py"
          },
          "path_suffix": {
            "const": "/skills/.system/plugin-creator/scripts/identifier_validation.py"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "reviewed_at": {"type": "string", "format": "date"},
    "review_due": {"type": "string", "format": "date"},
    "review_basis": {"type": "string", "minLength": 20, "maxLength": 500},
    "trust_boundary": {"type": "string", "minLength": 20, "maxLength": 500}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "classification", "source_type", "publisher", "owner", "created", "last_reviewed", "next_review", "retrieved", "url", "locator", "confidence"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
    "status": {"enum": ["candidate", "active", "retired", "rejected"]},
    "classification": {"enum": ["public", "internal", "confidential"]},
    "source_type": {"enum": ["standard", "research", "web_census", "official_guidance", "platform_documentation", "platform_guidance", "expert_guidance", "community_synthesis", "qualitative_community", "owner_preference", "internal_evaluation"]},
    "publisher": {"type": "string", "minLength": 2},
    "created": {"type": "string", "format": "date"},
    "last_reviewed": {"type": "string", "format": "date"},
    "next_review": {"type": "string", "format": "date"},
    "retrieved": {"type": "string", "format": "date"},
    "url": {"type": "string", "format": "uri"},
    "locator": {"type": "string", "minLength": 2},
    "confidence": {"enum": ["low", "medium", "high"]},
    "owner": {"type": "string", "minLength": 2, "not": {"enum": ["maintainer", "skill maintainer", "owner", "unknown", "tbd"]}},
    "evaluation_hosts": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evaluation_projects": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_path": {"type": "string", "minLength": 1, "not": {"pattern": "(?:^[/\\\\]|^[A-Za-z]:|(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))"}},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_path": {"type": "string", "pattern": "^maintainer/evidence/snapshots/EVD-[0-9]{3,}\\.json$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "independence_note", "replication_status"],
      "properties": {
        "kind": {"enum": ["original", "synthesis", "derivative", "upstream-observation", "internal-evaluation"]},
        "related_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}
        },
        "collection_window": {"type": "string", "minLength": 3},
        "sample_concentration_note": {"type": "string", "minLength": 8},
        "independence_note": {"type": "string", "minLength": 8},
        "replication_status": {"type": "string", "minLength": 8}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_type": {"const": "internal_evaluation"}}},
      "then": {"required": ["evaluation_hosts", "evaluation_projects", "artifact_path", "artifact_sha256"]}
    },
    {
      "if": {
        "properties": {
          "status": {"const": "active"},
          "source_type": {"enum": ["platform_documentation", "platform_guidance"]}
        },
        "required": ["status", "source_type"]
      },
      "then": {"required": ["source_snapshot_path", "source_snapshot_sha256"]}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "started_at",
    "completed_at",
    "duration_seconds",
    "python",
    "dependencies",
    "command",
    "inputs",
    "result",
    "output"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "design-dna-test-attestation"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "executable"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)?$"
        },
        "executable": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pinned", "installed"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "pinned": {"type": "string", "minLength": 1},
          "installed": {"type": "string", "minLength": 1}
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"const": "-B"},
        {"const": "-m"},
        {"const": "unittest"},
        {"const": "discover"},
        {"const": "-s"},
        {"const": "maintainer/tests"},
        {"const": "-p"},
        {"const": "test_*.py"},
        {"const": "-v"}
      ],
      "items": false
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_sha256",
        "tooling_sha256",
        "schemas_sha256",
        "requirements_sha256"
      ],
      "properties": {
        "tests_sha256": {"$ref": "#/$defs/sha256"},
        "tooling_sha256": {"$ref": "#/$defs/sha256"},
        "schemas_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "return_code",
        "tests_run",
        "failures",
        "errors",
        "skipped",
        "expected_failures",
        "unexpected_successes"
      ],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "return_code": {"type": "integer"},
        "tests_run": {"type": "integer", "minimum": 1},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "expected_failures": {"type": "integer", "minimum": 0},
        "unexpected_successes": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr",
        "sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "properties": {
        "stdout": {"type": "string", "maxLength": 10000000},
        "stderr": {"type": "string", "maxLength": 10000000},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "started_at",
    "completed_at",
    "duration_seconds",
    "python",
    "dependencies",
    "command",
    "inputs",
    "result",
    "output",
    "skip_waiver",
    "test_applicability"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "record_type": {"const": "design-dna-test-attestation"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "executable",
        "executable_sha256"
      ],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)?$"
        },
        "executable": {"const": "python-current-environment"},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pinned", "installed"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "pinned": {"type": "string", "minLength": 1},
          "installed": {"type": "string", "minLength": 1}
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": "python-current-environment"},
        {"const": "-I"},
        {"const": "-S"},
        {"const": "-B"},
        {"const": "maintainer/scripts/run_release_tests.py"}
      ],
      "items": false
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_sha256",
        "tests_sha256",
        "tooling_sha256",
        "schemas_sha256",
        "requirements_sha256",
        "requirements_lock_sha256"
      ],
      "properties": {
        "runtime_sha256": {"$ref": "#/$defs/sha256"},
        "tests_sha256": {"$ref": "#/$defs/sha256"},
        "tooling_sha256": {"$ref": "#/$defs/sha256"},
        "schemas_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "return_code",
        "tests_run",
        "failures",
        "errors",
        "skipped",
        "expected_failures",
        "unexpected_successes"
        ,
        "skipped_test_ids"
      ],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "return_code": {"type": "integer"},
        "tests_run": {"type": "integer", "minimum": 1},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "expected_failures": {"type": "integer", "minimum": 0},
        "unexpected_successes": {"type": "integer", "minimum": 0}
        ,
        "skipped_test_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$"
          }
        }
      }
    },
    "test_applicability": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "policy_sha256", "platform", "discovered_tests", "selected_tests", "executed_tests", "not_applicable_test_ids", "executed_native_test_ids"],
      "properties": {
        "schema_version": {"const": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {"enum": ["Windows", "Linux", "Darwin"]},
        "discovered_tests": {"type": "integer", "minimum": 1},
        "selected_tests": {"type": "integer", "minimum": 1},
        "executed_tests": {"type": "integer", "minimum": 1},
        "not_applicable_test_ids": {"$ref": "#/$defs/native_test_ids"},
        "executed_native_test_ids": {"$ref": "#/$defs/native_test_ids"}
      }
    },
    "skip_waiver": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_path",
            "source_sha256",
            "matched_test_ids",
            "evidence"
          ],
          "properties": {
            "source_path": {"$ref": "#/$defs/relative_path"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "matched_test_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$"
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"$ref": "#/$defs/relative_path"},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr",
        "sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "properties": {
        "stdout": {"type": "string", "maxLength": 10000000},
        "stderr": {"type": "string", "maxLength": 10000000},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"status": {"const": "passed"}}}}},
      "then": {"properties": {"test_applicability": {"type": "object"}}}
    }
  ],
  "$defs": {
    "native_test_ids": {
      "type": "array", "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "enum": [
        "test_maintainer_tools.EvalRunnerV3Tests.test_windows_assignment_failure_never_releases_driver",
        "test_maintainer_tools.EvalRunnerV3Tests.test_windows_job_termination_fallback_is_measured_and_verified",
        "test_maintainer_tools.EvalRunnerV3Tests.test_windows_job_termination_is_verified_without_taskkill",
        "test_maintainer_tools.EvalRunnerV3Tests.test_windows_unverified_tree_termination_fails_with_exact_evidence"
      ]}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^[/\\\\]|^[A-Za-z]:|\\\\|//|(?:^|/)\\.{1,2}(?:/|$)|[\\u0000-\\u001f\\u007f])"
          }
        },
        {"not": {"pattern": "/$"}},
        {"not": {"pattern": "^\\s|\\s$"}}
      ]
    }
  }
}

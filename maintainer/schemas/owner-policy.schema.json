{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "scope",
    "status",
    "defaults",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "owner": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "retired"]},
    "defaults": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "additionalProperties": {
        "enum": [
          "require",
          "require-review",
          "investigate",
          "allow",
          "ask",
          "prohibit",
          "opt-in",
          "off",
          "on"
        ]
      }
    },
    "interpretation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5, "maxLength": 2000}
    }
  }
}

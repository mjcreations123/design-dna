{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "approved_at",
    "expires_at",
    "owner",
    "applicability",
    "inputs",
    "waivers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "design-dna-test-skip-waivers"},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "machine_architecture",
        "python_implementation",
        "python_version"
      ],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 128},
        "release": {"type": "string", "minLength": 1, "maxLength": 256},
        "machine_architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)?$"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_sha256",
        "tests_sha256",
        "tooling_sha256",
        "schemas_sha256",
        "requirements_sha256",
        "requirements_lock_sha256"
      ],
      "properties": {
        "runtime_sha256": {"$ref": "#/$defs/sha256"},
        "tests_sha256": {"$ref": "#/$defs/sha256"},
        "tooling_sha256": {"$ref": "#/$defs/sha256"},
        "schemas_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "waivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "reason",
          "compensating_evidence"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000,
            "pattern": ".*\\S.*"
          },
          "compensating_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"$ref": "#/$defs/relative_path"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^[/\\\\]|^[A-Za-z]:|\\\\|//|(?:^|/)\\.{1,2}(?:/|$)|[\\u0000-\\u001f\\u007f])"
          }
        },
        {"not": {"pattern": "/$"}},
        {"not": {"pattern": "^\\s|\\s$"}}
      ]
    }
  }
}

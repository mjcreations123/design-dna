{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-dna.local/schemas/scan-result.schema.json",
  "title": "Design DNA source scan result",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "executionSucceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ok"],
      "properties": {
        "status": {"const": "succeeded"},
        "ok": {"const": true}
      }
    },
    "executionFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ok"],
      "properties": {
        "status": {"const": "failed"},
        "ok": {"const": false}
      }
    },
    "portableInputLabel": {
      "type": "string",
      "minLength": 9,
      "maxLength": 256,
      "pattern": "^(?:project:/|skill:/)(?:[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*)?$|^external:(?:allowlist|owner-policy):sha256:[0-9a-f]{64}$",
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high", "medium", "low"],
      "properties": {
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}
      }
    },
    "allowEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "path",
        "fingerprint",
        "reason",
        "owner",
        "expires"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 5},
        "owner": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "skippedAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "reason",
        "owner",
        "expires"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 5},
        "owner": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "findingCore": {
      "type": "object",
      "required": [
        "rule",
        "severity",
        "classification",
        "file",
        "line",
        "excerpt",
        "rationale",
        "suggestion",
        "owner_policy",
        "fingerprint"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "severity": {"enum": ["high", "medium", "low"]},
        "classification": {"enum": ["gate", "advisory"]},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string"},
        "matched_signal": {},
        "matched_signals": {
          "type": "array",
          "items": {"type": "object"}
        },
        "rationale": {"type": "string", "minLength": 1},
        "suggestion": {"type": "string", "minLength": 1},
        "owner_policy": {"type": ["string", "null"]},
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "finding": {
      "allOf": [
        {"$ref": "#/$defs/findingCore"}
      ]
    },
    "suppressedFinding": {
      "allOf": [
        {"$ref": "#/$defs/findingCore"},
        {
          "type": "object",
          "required": ["suppression"],
          "properties": {
            "suppression": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "rule",
                "path",
                "line",
                "fingerprint",
                "reason",
                "owner",
                "expires"
              ],
              "properties": {
                "source": {"const": "allowlist"},
                "rule": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "line": {"type": ["integer", "null"], "minimum": 1},
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": {"type": "string", "minLength": 5},
                "owner": {"type": "string", "minLength": 1},
                "expires": {"type": "string", "format": "date"}
              }
            }
          }
        }
      ]
    },
    "skippedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "reason",
        "sha256",
        "size_bytes",
        "acknowledged",
        "acknowledgement"
      ],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "acknowledged": {"type": "boolean"},
        "acknowledgement": {
          "oneOf": [
            {"$ref": "#/$defs/skippedAcknowledgement"},
            {"type": "null"}
          ]
        }
      }
    },
    "manualReview": {
      "type": "object",
      "required": ["file", "line", "check", "reason"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "check": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "ok",
        "execution_ok",
        "execution",
        "runtime_requirement",
        "disclaimer",
        "project",
        "include_patterns",
        "documentation_mode",
        "structured_content_mode",
        "built_output_mode",
        "gate_enforced",
        "gate_threshold",
        "gate_passed",
        "source_gate_passed",
        "quality_passed",
        "quality_status",
        "review_required",
        "design_review_status",
        "unresolved_advisory_count",
        "manual_review_count",
        "review",
        "exit_code",
        "exit_policy",
        "quality",
        "default_content_exclusions",
        "source_coverage",
        "allowlist",
        "owner_policy",
        "active_allowlist_entries",
        "expired_allowlist_entries",
        "allowlist_suppression_counts",
        "active_skipped_source_acknowledgements",
        "expired_skipped_source_acknowledgements",
        "suppressed_count",
        "suppressed_findings",
        "excluded_default_files",
        "excluded_sensitive_structured_files",
        "skipped_non_utf8_files",
        "skipped_oversized_files",
        "scan_status",
        "scan_complete",
        "selected_scope_complete",
        "scan_scope",
        "gate_status",
        "skipped_sources",
        "unacknowledged_skipped_files",
        "acknowledged_skipped_files",
        "limitations",
        "manual_review",
        "counts",
        "gate_counts",
        "advisory_counts",
        "findings"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_type": {"const": "design-dna-source-scan"},
        "ok": {"type": "boolean"},
        "execution_ok": {"const": true},
        "execution": {"$ref": "#/$defs/executionSucceeded"},
        "runtime_requirement": {"const": "Python >=3.10"},
        "disclaimer": {"type": "string", "minLength": 1},
        "project": {"const": "project:/"},
        "include_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "documentation_mode": {"type": "boolean"},
        "structured_content_mode": {"type": "boolean"},
        "built_output_mode": {"type": "boolean"},
        "gate_enforced": {"type": "boolean"},
        "gate_threshold": {"enum": ["none", "high", "medium", "low"]},
        "gate_passed": {"type": "boolean"},
        "source_gate_passed": {"type": "boolean"},
        "quality_passed": {"type": "boolean"},
        "quality_status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "acknowledged-incomplete",
            "no-eligible-sources",
            "no-selected-sources",
            "no-scanned-sources"
          ]
        },
        "review_required": {"type": "boolean"},
        "design_review_status": {
          "enum": ["pending", "not-triggered-by-source"]
        },
        "unresolved_advisory_count": {"type": "integer", "minimum": 0},
        "manual_review_count": {"type": "integer", "minimum": 0},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "status",
            "unresolved_advisory_count",
            "manual_review_count",
            "note"
          ],
          "properties": {
            "required": {"type": "boolean"},
            "status": {"enum": ["pending", "not-triggered-by-source"]},
            "unresolved_advisory_count": {
              "type": "integer",
              "minimum": 0
            },
            "manual_review_count": {"type": "integer", "minimum": 0},
            "note": {"type": "string", "minLength": 1}
          }
        },
        "exit_code": {"enum": [0, 1]},
        "exit_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fail_on",
            "default_fail_on",
            "enforced",
            "explicit_advisory_exit_zero",
            "explicit_fail_on_none",
            "triggered",
            "gate_finding_failure",
            "incomplete_source_failure",
            "exit_code"
          ],
          "properties": {
            "fail_on": {"enum": ["none", "high", "medium", "low"]},
            "default_fail_on": {"const": "high"},
            "enforced": {"type": "boolean"},
            "explicit_advisory_exit_zero": {"type": "boolean"},
            "explicit_fail_on_none": {"type": "boolean"},
            "triggered": {"type": "boolean"},
            "gate_finding_failure": {"type": "boolean"},
            "incomplete_source_failure": {"type": "boolean"},
            "exit_code": {"enum": [0, 1]}
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "passed",
            "confirmed_gate_finding_count",
            "unacknowledged_skipped_source_count",
            "skipped_source_count",
            "empty_source_failure",
            "scope_basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "incomplete",
                "acknowledged-incomplete",
                "no-eligible-sources",
                "no-selected-sources",
                "no-scanned-sources"
              ]
            },
            "passed": {"type": "boolean"},
            "confirmed_gate_finding_count": {
              "type": "integer",
              "minimum": 0
            },
            "unacknowledged_skipped_source_count": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_source_count": {"type": "integer", "minimum": 0},
            "empty_source_failure": {"type": "boolean"},
            "scope_basis": {
              "enum": [
                "complete-eligible-source-scope",
                "selected-scanned-scope-only"
              ]
            }
          }
        },
        "default_content_exclusions": {"type": "string", "minLength": 1},
        "source_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded",
            "suffixes",
            "documentation_mode",
            "structured_content_mode",
            "built_output_mode",
            "built_output_directories",
            "always_excluded_directories",
            "dependency_vendor_exclusions",
            "note"
          ],
          "properties": {
            "bounded": {"const": true},
            "suffixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^\\."}
            },
            "documentation_mode": {"type": "boolean"},
            "structured_content_mode": {"type": "boolean"},
            "built_output_mode": {"type": "boolean"},
            "built_output_directories": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "always_excluded_directories": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "dependency_vendor_exclusions": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "note": {"type": "string", "minLength": 1}
          }
        },
        "allowlist": {
          "oneOf": [
            {"$ref": "#/$defs/portableInputLabel"},
            {"type": "null"}
          ]
        },
        "owner_policy": {
          "oneOf": [
            {"$ref": "#/$defs/portableInputLabel"},
            {"type": "null"}
          ]
        },
        "active_allowlist_entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/allowEntry"}
        },
        "expired_allowlist_entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/allowEntry"}
        },
        "allowlist_suppression_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry", "suppressed_count"],
            "properties": {
              "entry": {"$ref": "#/$defs/allowEntry"},
              "suppressed_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "active_skipped_source_acknowledgements": {
          "type": "array",
          "items": {"$ref": "#/$defs/skippedAcknowledgement"}
        },
        "expired_skipped_source_acknowledgements": {
          "type": "array",
          "items": {"$ref": "#/$defs/skippedAcknowledgement"}
        },
        "suppressed_count": {"type": "integer", "minimum": 0},
        "suppressed_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/suppressedFinding"}
        },
        "excluded_default_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_sensitive_structured_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "skipped_non_utf8_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "skipped_oversized_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "scan_status": {
          "enum": [
            "complete",
            "scope-limited",
            "incomplete",
            "no-eligible-sources",
            "no-selected-sources",
            "no-scanned-sources"
          ]
        },
        "scan_complete": {"type": "boolean"},
        "selected_scope_complete": {"type": "boolean"},
        "scan_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "complete",
            "selected_scope_complete",
            "mode",
            "eligible_file_count",
            "selected_file_count",
            "scanned_file_count",
            "excluded_eligible_file_count",
            "skipped_selected_file_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "scope-limited",
                "incomplete",
                "no-eligible-sources",
                "no-selected-sources",
                "no-scanned-sources"
              ]
            },
            "complete": {"type": "boolean"},
            "selected_scope_complete": {"type": "boolean"},
            "mode": {
              "enum": [
                "application-source",
                "documentation-content-site"
              ]
            },
            "eligible_file_count": {"type": "integer", "minimum": 0},
            "selected_file_count": {"type": "integer", "minimum": 0},
            "scanned_file_count": {"type": "integer", "minimum": 0},
            "excluded_eligible_file_count": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_selected_file_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gate_status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "acknowledged-incomplete",
            "no-eligible-sources",
            "no-selected-sources",
            "no-scanned-sources"
          ]
        },
        "skipped_sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/skippedSource"}
        },
        "unacknowledged_skipped_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "acknowledged_skipped_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "manual_review": {
          "type": "array",
          "items": {"$ref": "#/$defs/manualReview"}
        },
        "counts": {"$ref": "#/$defs/severityCounts"},
        "gate_counts": {"$ref": "#/$defs/severityCounts"},
        "advisory_counts": {"$ref": "#/$defs/severityCounts"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "ok",
        "execution_ok",
        "execution",
        "error"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_type": {"const": "design-dna-source-scan"},
        "ok": {"const": false},
        "execution_ok": {"const": false},
        "execution": {"$ref": "#/$defs/executionFailed"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "required": {"type": "string", "minLength": 1},
            "current": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

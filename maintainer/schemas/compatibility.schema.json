{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "package_version",
    "discovery_roots",
    "hosts",
    "portable_contract"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "last_updated": {"type": "string", "format": "date"},
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "discovery_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude_code"],
      "properties": {
        "codex": {"$ref": "#/$defs/host"},
        "claude_code": {"$ref": "#/$defs/host"}
      }
    },
    "portable_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_entrypoint",
        "host_specific_runtime_references",
        "unsupported_claims"
      ],
      "properties": {
        "skill_entrypoint": {"const": "skills/design-dna/SKILL.md"},
        "host_specific_runtime_references": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unsupported_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        }
      }
    },
    "release_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "pending",
        "passed",
        "failed",
        "blocked_not_authenticated",
        "not_applicable"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_route",
        "designed",
        "static_validation",
        "isolated_behavioral_eval",
        "rendered_eval",
        "installed_sync",
        "notes"
      ],
      "properties": {
        "discovery_route": {"type": "string", "minLength": 1},
        "designed": {"const": true},
        "static_validation": {"$ref": "#/$defs/status"},
        "isolated_behavioral_eval": {"$ref": "#/$defs/status"},
        "rendered_eval": {"$ref": "#/$defs/status"},
        "installed_sync": {"$ref": "#/$defs/status"},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}

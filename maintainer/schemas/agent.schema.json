{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface", "policy"],
  "properties": {
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "short_description", "default_prompt"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "short_description": {"type": "string", "minLength": 25, "maxLength": 64},
        "default_prompt": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\$design-dna"},
        "icon_small": {"type": "string"},
        "icon_large": {"type": "string"},
        "brand_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_implicit_invocation"],
      "properties": {
        "allow_implicit_invocation": {"const": true}
      }
    }
  }
}
